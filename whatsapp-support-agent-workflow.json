    {
      "parameters": {
        "jsCode": "// Extract message data from WhatsApp webhook payload\nconst items = [];\n\nfor (const item of $input.all()) {\n  const entry = item.json?.entry?.[0];\n  const changes = entry?.changes?.[0];\n  const value = changes?.value;\n  \n  if (!value?.messages) {\n    continue;\n  }\n  \n  for (const message of value.messages) {\n    const contact = value.contacts?.[0];\n    \n    items.push({\n      json: {\n        messageId: message.id,\n        from: message.from,\n        timestamp: message.timestamp,\n        type: message.type,\n        contactName: contact?.profile?.name || 'Unknown',\n        phoneNumberId: value.metadata?.phone_number_id,\n        businessAccountId: entry?.id,\n        \n        // Message content based on type\n        text: message.text?.body,\n        imageId: message.image?.id,\n        imageMimeType: message.image?.mime_type,\n        imageCaption: message.image?.caption,\n        audioId: message.audio?.id,\n        audioMimeType: message.audio?.mime_type,\n        documentId: message.document?.id,\n        documentMimeType: message.document?.mime_type,\n        documentFilename: message.document?.filename,\n        documentCaption: message.document?.caption,\n        videoId: message.video?.id,\n        videoMimeType: message.video?.mime_type,\n        videoCaption: message.video?.caption,\n        location: message.location,\n        \n        // Context (for replies)\n        contextMessageId: message.context?.id,\n        \n        // Raw message for debugging\n        rawMessage: message\n      }\n    });\n  }\n}\n\nreturn items;"
      },
