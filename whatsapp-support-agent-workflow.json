      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Merge conversation history with current message\nconst items = [];\n\nfor (const item of $input.all()) {\n  const history = item.json.conversation_history || [];\n  const currentMessage = {\n    role: 'user',\n    content: item.json.processedContent,\n    timestamp: new Date().toISOString()\n  };\n  \n  // Keep last 10 messages for context\n  const contextMessages = [...history.slice(-10), currentMessage];\n  \n  items.push({\n    json: {\n      ...item.json,\n      conversationHistory: history,\n      contextMessages,\n      currentMessage\n    }\n  });\n}\n\nreturn items;"
      },
