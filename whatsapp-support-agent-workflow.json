    {
      "parameters": {
        "jsCode": "// Extract text from PDF document\nconst items = [];\n\nfor (const item of $input.all()) {\n  const binaryData = item.binary?.data;\n  \n  if (!binaryData) {\n    items.push({\n      json: {\n        ...item.json,\n        extractedText: 'Unable to extract text from document',\n        processedContent: `User sent a document: ${item.json.documentFilename || 'unknown file'}`\n      }\n    });\n    continue;\n  }\n  \n  // Note: In production, use a proper PDF parser library\n  // For now, create a placeholder\n  items.push({\n    json: {\n      ...item.json,\n      extractedText: 'PDF content extraction requires additional setup',\n      processedContent: `User sent a PDF document named \"${item.json.documentFilename}\". ${item.json.documentCaption ? 'Caption: ' + item.json.documentCaption : ''}`\n    }\n  });\n}\n\nreturn items;"
      },
      "id": "extract-pdf-text",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 960]
    },
    {
      "parameters": {
        "jsCode": "// Prepare processed content for all message types\nconst items = [];\n\nfor (const item of $input.all()) {\n  let processedContent = '';\n  \n  if (item.json.text) {\n    processedContent = item.json.text;\n  } else if (item.json.transcription) {\n    processedContent = `[Voice message transcription]: ${item.json.transcription}`;\n  } else if (item.json.imageAnalysis) {\n    processedContent = `[Image analysis]: ${item.json.imageAnalysis}`;\n  } else if (item.json.processedContent) {\n    processedContent = item.json.processedContent;\n  }\n  \n  items.push({\n    json: {\n      ...item.json,\n      processedContent\n    }\n  });\n}\n\nreturn items;"
      },
      "id": "prepare-content",
      "name": "Prepare Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 680]
    },
