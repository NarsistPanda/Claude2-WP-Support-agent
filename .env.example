# WhatsApp Business API Configuration
# Get these from Meta Developer Portal: https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500

# PostgreSQL Database Configuration
# For conversation history and user data storage
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_support_agent
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=false

# n8n Configuration
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://your-domain.com

# Webhook Configuration
WEBHOOK_PATH=whatsapp-webhook
WEBHOOK_URL=${N8N_WEBHOOK_URL}/${WEBHOOK_PATH}

# Redis Configuration (Optional - for caching and session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Vector Database Configuration (Optional - for RAG)
# Choose one: Pinecone, Qdrant, or Weaviate

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX=whatsapp-support-knowledge

# Qdrant (if self-hosting)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=whatsapp-support-knowledge

# Application Settings
APP_NAME=WhatsApp AI Support Agent
APP_ENVIRONMENT=production
LOG_LEVEL=info

# Rate Limiting
MAX_MESSAGES_PER_MINUTE=60
MAX_MESSAGES_PER_HOUR=1000

# AI Agent Settings
AI_RESPONSE_MAX_LENGTH=1000
AI_CONVERSATION_HISTORY_LIMIT=10
AI_SYSTEM_PROMPT_OVERRIDE=

# Feature Flags
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_PDF_EXTRACTION=true
ENABLE_CONVERSATION_MEMORY=true
ENABLE_RAG=false

# Monitoring & Analytics (Optional)
SENTRY_DSN=
ANALYTICS_ENABLED=false

# Backup & Data Retention
CONVERSATION_RETENTION_DAYS=90
AUTO_BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
