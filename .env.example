#================================================================================
# WhatsApp AI Support Agent - Environment Configuration
#================================================================================
# PRODUCTION DEPLOYMENT: Follow security best practices
# 1. Generate strong passwords using: openssl rand -base64 32
# 2. Use Azure Key Vault or secrets management for production
# 3. Never commit this file with real values to version control
# 4. Set appropriate permissions: chmod 600 .env
#================================================================================

#================================================================================
# ENVIRONMENT SETTINGS
#================================================================================

# Environment type (development, staging, production)
NODE_ENV=production
APP_ENVIRONMENT=production
APP_NAME=WhatsApp AI Support Agent

# Timezone (use IANA timezone format)
TIMEZONE=UTC

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_DEBUG_LOGS=false

#================================================================================
# WHATSAPP BUSINESS API CONFIGURATION
#================================================================================
# Get credentials from Meta Developer Portal: https://developers.facebook.com/
# Documentation: https://developers.facebook.com/docs/whatsapp/cloud-api

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here  # Generate with: openssl rand -hex 32

# WhatsApp API Settings
WHATSAPP_API_VERSION=v18.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

#================================================================================
# OPENAI API CONFIGURATION
#================================================================================
# Get API key from: https://platform.openai.com/api-keys
# Pricing: https://openai.com/pricing

OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_ORGANIZATION_ID=  # Optional - for organization accounts

# Model Configuration
OPENAI_MODEL=gpt-4o-mini  # Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7  # 0.0-2.0 (lower = more deterministic)
OPENAI_MAX_TOKENS=500  # Max tokens per response
OPENAI_TOP_P=1.0  # Nucleus sampling (0.0-1.0)
OPENAI_FREQUENCY_PENALTY=0.0  # -2.0 to 2.0
OPENAI_PRESENCE_PENALTY=0.0  # -2.0 to 2.0

# Vision Model (for image/video analysis)
OPENAI_VISION_MODEL=gpt-4o  # Required for image analysis
OPENAI_VISION_MAX_TOKENS=300
OPENAI_VISION_DETAIL=auto  # Options: low, high, auto

# Whisper (for audio transcription)
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_LANGUAGE=  # Optional - leave empty for auto-detect

# TTS (Text-to-Speech for voice responses)
OPENAI_TTS_MODEL=tts-1  # Options: tts-1, tts-1-hd
OPENAI_TTS_VOICE=alloy  # Options: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_SPEED=1.0  # 0.25 to 4.0

#================================================================================
# DATABASE CONFIGURATION - PostgreSQL
#================================================================================
# For Docker Compose deployment
DB_HOST=WPSupport_postgres
DB_PORT=5432
DB_NAME=whatsapp_support_agent
DB_USER=n8n_user
DB_PASSWORD=  # REQUIRED - Generate with: openssl rand -base64 32
DB_SSL=false  # Set to true for cloud deployments

# For Azure Database for PostgreSQL (overrides above when using Azure)
# AZURE_POSTGRES_HOST=your-server.postgres.database.azure.com
# AZURE_POSTGRES_PORT=5432
# AZURE_POSTGRES_DATABASE=whatsapp_support_agent
# AZURE_POSTGRES_USER=your_admin_user
# AZURE_POSTGRES_PASSWORD=  # Store in Azure Key Vault
# AZURE_POSTGRES_SSL=true

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=30000  # milliseconds
DB_IDLE_TIMEOUT=10000  # milliseconds

# Database Performance
DB_STATEMENT_TIMEOUT=30000  # milliseconds
DB_QUERY_TIMEOUT=30000  # milliseconds

#================================================================================
# REDIS CONFIGURATION
#================================================================================
# For Docker Compose deployment
REDIS_HOST=WPSupport_redis
REDIS_PORT=6379
REDIS_PASSWORD=  # RECOMMENDED - Generate with: openssl rand -base64 32
REDIS_DB=0
REDIS_MAXMEMORY=512mb

# For Azure Cache for Redis (overrides above when using Azure)
# AZURE_REDIS_HOST=your-cache.redis.cache.windows.net
# AZURE_REDIS_PORT=6380
# AZURE_REDIS_PASSWORD=  # Store in Azure Key Vault
# AZURE_REDIS_SSL=true
# AZURE_REDIS_DB=0

# Redis Connection Settings
REDIS_CONNECT_TIMEOUT=10000  # milliseconds
REDIS_KEEP_ALIVE=30000  # milliseconds
REDIS_RETRY_STRATEGY_MAX_ATTEMPTS=10

#================================================================================
# N8N WORKFLOW AUTOMATION CONFIGURATION
#================================================================================

# Basic n8n Settings
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https  # Use https in production
N8N_WEBHOOK_URL=https://your-domain.com  # REQUIRED - Your public URL

# Security - Basic Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=  # REQUIRED - Generate with: openssl rand -base64 32

# Encryption
N8N_ENCRYPTION_KEY=  # REQUIRED - Generate with: openssl rand -hex 32

# Execution Mode
EXECUTIONS_MODE=queue  # Options: regular, queue (queue recommended for production)
EXECUTIONS_PROCESS=main  # Options: main, own

# Queue Configuration (when using queue mode)
QUEUE_BULL_REDIS_HOST=WPSupport_redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=${REDIS_PASSWORD}
QUEUE_BULL_REDIS_DB=0
QUEUE_HEALTH_CHECK_ACTIVE=true

# Logging
N8N_LOG_LEVEL=info  # Options: error, warn, info, verbose, debug
N8N_LOG_OUTPUT=console,file
N8N_LOG_FILE_LOCATION=/home/node/.n8n/logs/
N8N_LOG_FILE_COUNT_MAX=50
N8N_LOG_FILE_SIZE_MAX_MB=16

# Performance & Limits
N8N_PAYLOAD_SIZE_MAX=32  # MB - Increased for video support
N8N_METRICS=true
N8N_METRICS_PREFIX=n8n_

# Execution Settings
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_MAX_AGE=168  # hours (7 days)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Workflow Settings
WORKFLOWS_DEFAULT_NAME=WhatsApp Support Workflow
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_BINARY_DATA_TTL=24  # hours

# Webhook Configuration
WEBHOOK_PATH=whatsapp-webhook
WEBHOOK_URL=${N8N_WEBHOOK_URL}/webhook/${WEBHOOK_PATH}

#================================================================================
# AI AGENT SETTINGS
#================================================================================

# Response Configuration
AI_RESPONSE_MAX_LENGTH=1000  # characters
AI_CONVERSATION_HISTORY_LIMIT=10  # messages
AI_SYSTEM_PROMPT_OVERRIDE=  # Optional - override default system prompt

# Rate Limiting
MAX_MESSAGES_PER_MINUTE=60
MAX_MESSAGES_PER_HOUR=1000
MAX_MESSAGES_PER_DAY=10000

# User Rate Limiting
MAX_USER_MESSAGES_PER_MINUTE=10
MAX_USER_MESSAGES_PER_HOUR=100

#================================================================================
# FEATURE FLAGS - CORE FEATURES
#================================================================================

ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_PDF_EXTRACTION=true
ENABLE_DOCUMENT_ANALYSIS=true
ENABLE_CONVERSATION_MEMORY=true
ENABLE_RAG=false  # Retrieval Augmented Generation (requires Qdrant)

#================================================================================
# FEATURE FLAGS - V2.0 ENHANCED FEATURES
#================================================================================

# Human Handoff
ENABLE_HUMAN_HANDOFF=true
HANDOFF_KEYWORDS=human,agent,representative,speak to someone,talk to person,escalate,supervisor,manager
SENTIMENT_THRESHOLD=0.3  # Trigger handoff if sentiment score below this (0.0-1.0)
UNRESOLVED_QUERY_LIMIT=3  # Handoff after N unresolved attempts
HANDOFF_TIMEOUT_MINUTES=30  # Auto-close handoff after N minutes

# Proactive Messaging
ENABLE_PROACTIVE_MESSAGING=true
PROACTIVE_CHECK_INTERVAL=5  # Check for pending messages every N minutes
MAX_BULK_RECIPIENTS=100  # Max recipients per batch
DAILY_MESSAGE_LIMIT_PER_USER=5  # Max proactive messages per user per day
HOURLY_BROADCAST_LIMIT=1000  # Max broadcast messages per hour

# Voice Responses
ENABLE_VOICE_RESPONSES=true
VOICE_RESPONSE_AUTO=false  # Auto-send voice or require user opt-in
VOICE_RESPONSE_MAX_LENGTH=500  # Max characters for voice conversion
VOICE_CACHE_ENABLED=true  # Cache common voice responses
VOICE_TRIGGER_KEYWORDS=voice,audio,speak,read aloud
VOICE_LENGTH_THRESHOLD=200  # Only use voice for responses longer than N chars

# Video Support
ENABLE_VIDEO_SUPPORT=true
VIDEO_MAX_SIZE_MB=16  # WhatsApp limit
VIDEO_PROCESSING_TIMEOUT=60  # seconds
VIDEO_FRAME_INTERVAL=5  # Extract frame every N seconds
VIDEO_MAX_DURATION=60  # Only process videos under N seconds
VIDEO_ANALYSIS_ENABLED=true  # Use AI to analyze video frames
VIDEO_AUTO_DELETE=true  # Delete after processing
VIDEO_RETENTION_DAYS=7  # Keep videos for N days

#================================================================================
# HUMAN HANDOFF - INTEGRATION OPTIONS
#================================================================================

# Slack Integration
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_HANDOFF_CHANNEL=#customer-support
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Email Integration
EMAIL_HANDOFF_ENABLED=false
HANDOFF_EMAIL_TO=support@company.com
HANDOFF_EMAIL_FROM=whatsapp-bot@company.com
HANDOFF_EMAIL_CC=  # Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password  # Use app-specific password
SMTP_SECURE=true  # Use TLS

# Microsoft Teams Integration
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...

# Custom Webhook (for CRM integration)
CUSTOM_WEBHOOK_ENABLED=false
HANDOFF_WEBHOOK_URL=https://your-crm.com/api/handoff
HANDOFF_WEBHOOK_AUTH=Bearer your-api-key
HANDOFF_WEBHOOK_METHOD=POST
HANDOFF_WEBHOOK_TIMEOUT=10000  # milliseconds

#================================================================================
# PROACTIVE MESSAGING CONFIGURATION
#================================================================================

# Quiet Hours (24-hour format)
PROACTIVE_QUIET_HOURS_START=22  # Don't send between 10 PM
PROACTIVE_QUIET_HOURS_END=8  # and 8 AM
RESPECT_TIMEZONE=true

# Message Templates
DEFAULT_TEMPLATE_LANGUAGE=en_US
ENABLE_TEMPLATE_CACHING=true

# Campaign Settings
MAX_CONCURRENT_CAMPAIGNS=5
CAMPAIGN_RETRY_FAILED=true
CAMPAIGN_RETRY_MAX_ATTEMPTS=3

#================================================================================
# STORAGE CONFIGURATION
#================================================================================

# Storage Provider (choose one: local, minio, azure, aws, gcs)
STORAGE_PROVIDER=minio  # Options: local, minio, azure, aws, gcs

# Local File System
LOCAL_STORAGE_PATH=/files
VIDEO_TEMP_DIR=/tmp/videos

# MinIO (S3-compatible - for Docker Compose deployment)
MINIO_ENABLED=true
MINIO_ENDPOINT=http://WPSupport_minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=  # REQUIRED - Generate with: openssl rand -base64 32
MINIO_BUCKET_VIDEOS=whatsapp-videos
MINIO_BUCKET_VOICE=whatsapp-voice
MINIO_BUCKET_MEDIA=whatsapp-media
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Azure Blob Storage (for Azure deployment)
AZURE_STORAGE_ENABLED=false
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=  # Store in Azure Key Vault
AZURE_STORAGE_CONNECTION_STRING=  # Alternative to account+key
AZURE_STORAGE_CONTAINER_VIDEOS=whatsapp-videos
AZURE_STORAGE_CONTAINER_VOICE=whatsapp-voice
AZURE_STORAGE_CONTAINER_MEDIA=whatsapp-media
AZURE_STORAGE_SAS_TOKEN=  # Optional - for temporary access

# AWS S3 (alternative)
AWS_ENABLED=false
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=whatsapp-videos
AWS_S3_ENDPOINT=  # Optional - for S3-compatible services

# Google Cloud Storage (alternative)
GCS_ENABLED=false
GCS_PROJECT_ID=your-project-id
GCS_BUCKET=whatsapp-videos
GCS_KEY_FILE=/path/to/service-account.json
GCS_CREDENTIALS=  # JSON string - alternative to key file

#================================================================================
# VECTOR DATABASE - RAG (Retrieval Augmented Generation)
#================================================================================

# Vector DB Provider (choose one: qdrant, pinecone, weaviate)
VECTOR_DB_PROVIDER=qdrant

# Qdrant (for Docker Compose or self-hosted)
QDRANT_ENABLED=false
QDRANT_URL=http://WPSupport_qdrant:6333
QDRANT_GRPC_URL=http://WPSupport_qdrant:6334
QDRANT_API_KEY=  # Optional - for authentication
QDRANT_COLLECTION=whatsapp-support-knowledge

# For Azure (Qdrant Cloud or deployed on Azure)
# QDRANT_CLOUD_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_CLOUD_API_KEY=  # Store in Azure Key Vault

# Pinecone (managed vector DB)
PINECONE_ENABLED=false
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX=whatsapp-support-knowledge

# Weaviate (alternative)
WEAVIATE_ENABLED=false
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_CLASS=WhatsAppKnowledge

# RAG Configuration
RAG_TOP_K=5  # Number of relevant docs to retrieve
RAG_SIMILARITY_THRESHOLD=0.7  # Minimum similarity score
RAG_CHUNK_SIZE=500  # Characters per chunk
RAG_CHUNK_OVERLAP=50  # Overlap between chunks

#================================================================================
# MONITORING & OBSERVABILITY
#================================================================================

# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=30

# Grafana
GRAFANA_ENABLED=false
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=  # REQUIRED if enabled - Generate with: openssl rand -base64 32
GRAFANA_ROOT_URL=http://localhost:3000

# Azure Application Insights (for Azure deployment)
AZURE_APPINSIGHTS_ENABLED=false
AZURE_APPINSIGHTS_CONNECTION_STRING=  # From Azure Portal
AZURE_APPINSIGHTS_INSTRUMENTATION_KEY=  # Legacy - use connection string instead

# Sentry Error Tracking
SENTRY_ENABLED=false
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=${APP_ENVIRONMENT}
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions
SENTRY_RELEASE=1.0.0

# Generic Analytics
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=  # Options: google-analytics, mixpanel, amplitude

#================================================================================
# BACKUP & DATA RETENTION
#================================================================================

# Automated Backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=@daily  # cron format or @daily, @weekly, @monthly
BACKUP_KEEP_DAYS=7  # Keep daily backups for 7 days
BACKUP_KEEP_WEEKS=4  # Keep weekly backups for 4 weeks
BACKUP_KEEP_MONTHS=6  # Keep monthly backups for 6 months

# Backup Storage
BACKUP_STORAGE_PROVIDER=local  # Options: local, azure, aws, gcs
BACKUP_STORAGE_PATH=./backups

# Azure Backup Storage
AZURE_BACKUP_ENABLED=false
AZURE_BACKUP_STORAGE_ACCOUNT=your-backup-storage
AZURE_BACKUP_CONTAINER=whatsapp-backups

# Data Retention
CONVERSATION_RETENTION_DAYS=90
MESSAGE_RETENTION_DAYS=90
AI_INTERACTION_RETENTION_DAYS=30
ERROR_LOG_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=365

# Auto-cleanup
AUTO_CLEANUP_ENABLED=true
CLEANUP_SCHEDULE=0 3 * * *  # Daily at 3 AM

#================================================================================
# SECURITY CONFIGURATION
#================================================================================

# API Security
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW=60000  # milliseconds (1 minute)
API_RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ENABLED=true
CORS_ORIGIN=*  # Set to specific domain in production
CORS_CREDENTIALS=true

# Helmet Security Headers
HELMET_ENABLED=true
HELMET_HSTS_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000  # 1 year

# Content Security Policy
CSP_ENABLED=false
CSP_DIRECTIVES=default-src 'self'

# IP Whitelisting (comma-separated)
IP_WHITELIST_ENABLED=false
IP_WHITELIST=

# Azure Key Vault (for secrets management)
AZURE_KEYVAULT_ENABLED=false
AZURE_KEYVAULT_URI=https://your-vault.vault.azure.net/
AZURE_KEYVAULT_TENANT_ID=your-tenant-id
AZURE_KEYVAULT_CLIENT_ID=your-client-id
AZURE_KEYVAULT_CLIENT_SECRET=  # For service principal auth

#================================================================================
# COST MANAGEMENT & LIMITS
#================================================================================

# OpenAI Cost Limits (monthly)
OPENAI_MONTHLY_BUDGET_USD=500
OPENAI_BUDGET_ALERT_THRESHOLD=0.8  # Alert at 80%

# Feature-specific Budgets
MONTHLY_VOICE_BUDGET_USD=50
MONTHLY_VIDEO_ANALYSIS_BUDGET_USD=100
MONTHLY_TTS_BUDGET_USD=50

# Alert Configuration
COST_ALERT_ENABLED=true
COST_ALERT_EMAIL=admin@company.com
COST_ALERT_WEBHOOK=  # Optional - for custom alerting

#================================================================================
# DOCKER COMPOSE CONFIGURATION
#================================================================================

# General Settings
COMPOSE_PROJECT_NAME=wpsupport

# Port Mappings
N8N_PORT=5678
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PGADMIN_PORT=8080
REDIS_COMMANDER_PORT=8081

# Development Tools (only enable in non-production)
PGADMIN_ENABLED=false
PGADMIN_EMAIL=admin@wpsupport.local
PGADMIN_PASSWORD=  # REQUIRED if enabled

REDIS_COMMANDER_ENABLED=false
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=  # REQUIRED if enabled

#================================================================================
# SSL & REVERSE PROXY
#================================================================================

# Nginx (for production deployment)
NGINX_ENABLED=false
NGINX_DOMAIN=your-domain.com
NGINX_EMAIL=admin@your-domain.com

# Let's Encrypt SSL
CERTBOT_ENABLED=false
CERTBOT_EMAIL=admin@your-domain.com
CERTBOT_DOMAIN=your-domain.com
CERTBOT_STAGING=false  # Use Let's Encrypt staging for testing

#================================================================================
# AZURE-SPECIFIC CONFIGURATION
#================================================================================

# Azure Resource Group
AZURE_RESOURCE_GROUP=whatsapp-support-rg
AZURE_LOCATION=eastus  # Options: eastus, westus, westeurope, etc.
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Azure Container Registry
AZURE_CONTAINER_REGISTRY=yourregistry.azurecr.io
AZURE_ACR_USERNAME=your-acr-username
AZURE_ACR_PASSWORD=  # Store in Azure Key Vault

# Azure Container Instances
AZURE_ACI_ENABLED=false
AZURE_ACI_CPU=2  # CPU cores
AZURE_ACI_MEMORY=4  # GB

# Azure Kubernetes Service
AZURE_AKS_ENABLED=false
AZURE_AKS_CLUSTER_NAME=whatsapp-support-aks
AZURE_AKS_NODE_COUNT=3
AZURE_AKS_NODE_SIZE=Standard_D2s_v3

# Azure App Service
AZURE_APPSERVICE_ENABLED=false
AZURE_APPSERVICE_PLAN=whatsapp-support-plan
AZURE_APPSERVICE_SKU=P1V2  # Options: F1, B1, B2, B3, S1, S2, S3, P1V2, P2V2, P3V2

# Azure Virtual Network
AZURE_VNET_ENABLED=false
AZURE_VNET_NAME=whatsapp-support-vnet
AZURE_VNET_ADDRESS_PREFIX=10.0.0.0/16
AZURE_SUBNET_NAME=default
AZURE_SUBNET_PREFIX=10.0.0.0/24

# Azure Load Balancer
AZURE_LB_ENABLED=false
AZURE_LB_SKU=Standard  # Options: Basic, Standard

# Azure Front Door (CDN)
AZURE_FRONTDOOR_ENABLED=false
AZURE_FRONTDOOR_NAME=whatsapp-support-fd

# Azure Monitor
AZURE_MONITOR_ENABLED=false
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
AZURE_LOG_ANALYTICS_WORKSPACE_KEY=  # Store in Azure Key Vault

#================================================================================
# DEVELOPMENT & DEBUGGING
#================================================================================

# Development Mode
DEV_MODE=false
ENABLE_HOT_RELOAD=false

# Debug Settings
DEBUG=false
DEBUG_WEBHOOKS=false
DEBUG_DATABASE=false
DEBUG_REDIS=false
DEBUG_OPENAI=false

# Testing
TEST_MODE=false
TEST_PHONE_NUMBER=  # For automated testing
MOCK_WHATSAPP_API=false
MOCK_OPENAI_API=false

#================================================================================
# DEPLOYMENT NOTES
#================================================================================
#
# QUICK START (Docker Compose):
# 1. Copy this file: cp .env.example .env
# 2. Generate secrets:
#    - DB_PASSWORD=$(openssl rand -base64 32)
#    - N8N_ENCRYPTION_KEY=$(openssl rand -hex 32)
#    - N8N_BASIC_AUTH_PASSWORD=$(openssl rand -base64 32)
# 3. Set required values:
#    - WHATSAPP_* credentials from Meta
#    - OPENAI_API_KEY from OpenAI
# 4. Deploy: docker-compose up -d
#
# AZURE DEPLOYMENT:
# See docs/AZURE-DEPLOYMENT.md for comprehensive Azure deployment guide
#
# PRODUCTION CHECKLIST:
# ✅ All passwords generated with strong randomness
# ✅ SSL/TLS enabled for all services
# ✅ Secrets stored in Azure Key Vault (recommended)
# ✅ Monitoring and alerting configured
# ✅ Backup strategy implemented
# ✅ Rate limiting enabled
# ✅ IP whitelisting configured (if applicable)
# ✅ Cost budgets set
# ✅ Data retention policies defined
#
#================================================================================
