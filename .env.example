# WhatsApp Business API Configuration
# Get these from Meta Developer Portal: https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500

# PostgreSQL Database Configuration
# For conversation history and user data storage
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_support_agent
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=false

# n8n Configuration
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://your-domain.com

# Webhook Configuration
WEBHOOK_PATH=whatsapp-webhook
WEBHOOK_URL=${N8N_WEBHOOK_URL}/${WEBHOOK_PATH}

# Redis Configuration (Optional - for caching and session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Vector Database Configuration (Optional - for RAG)
# Choose one: Pinecone, Qdrant, or Weaviate

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX=whatsapp-support-knowledge

# Qdrant (if self-hosting)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=whatsapp-support-knowledge

# Application Settings
APP_NAME=WhatsApp AI Support Agent
APP_ENVIRONMENT=production
LOG_LEVEL=info

# Rate Limiting
MAX_MESSAGES_PER_MINUTE=60
MAX_MESSAGES_PER_HOUR=1000

# AI Agent Settings
AI_RESPONSE_MAX_LENGTH=1000
AI_CONVERSATION_HISTORY_LIMIT=10
AI_SYSTEM_PROMPT_OVERRIDE=

# Feature Flags
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_PDF_EXTRACTION=true
ENABLE_CONVERSATION_MEMORY=true
ENABLE_RAG=false

# Monitoring & Analytics (Optional)
SENTRY_DSN=
ANALYTICS_ENABLED=false

# Backup & Data Retention
CONVERSATION_RETENTION_DAYS=90
AUTO_BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *

# ==============================================================================
# ENHANCED FEATURES
# ==============================================================================

# Human Handoff Configuration
ENABLE_HUMAN_HANDOFF=true
HANDOFF_KEYWORDS=human,agent,representative,speak to someone,talk to person,escalate
SENTIMENT_THRESHOLD=0.3  # Trigger handoff if sentiment score below this
UNRESOLVED_QUERY_LIMIT=3  # Handoff after N unresolved attempts

# Slack Integration (for agent notifications)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_HANDOFF_CHANNEL=#customer-support
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Email Integration (for agent notifications)
EMAIL_HANDOFF_ENABLED=false
HANDOFF_EMAIL_TO=support@company.com
HANDOFF_EMAIL_FROM=whatsapp-bot@company.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=true

# Custom Webhook (for CRM integration)
CUSTOM_WEBHOOK_ENABLED=false
HANDOFF_WEBHOOK_URL=https://your-crm.com/api/handoff
HANDOFF_WEBHOOK_AUTH=Bearer your-api-key
HANDOFF_WEBHOOK_METHOD=POST

# Proactive Messaging Configuration
ENABLE_PROACTIVE_MESSAGING=true
PROACTIVE_CHECK_INTERVAL=5  # Check for pending messages every N minutes
MAX_BULK_RECIPIENTS=100  # Max recipients per batch
PROACTIVE_QUIET_HOURS_START=22  # Don't send between 10 PM
PROACTIVE_QUIET_HOURS_END=8  # and 8 AM (24-hour format)
RESPECT_TIMEZONE=true

# Message Rate Limiting
DAILY_MESSAGE_LIMIT_PER_USER=5  # Max proactive messages per user per day
HOURLY_BROADCAST_LIMIT=1000  # Max broadcast messages per hour

# Voice Responses Configuration
ENABLE_VOICE_RESPONSES=true
VOICE_RESPONSE_AUTO=false  # Auto-send voice or require user opt-in
OPENAI_TTS_VOICE=alloy  # Options: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_SPEED=1.0  # 0.25 to 4.0
VOICE_RESPONSE_MAX_LENGTH=500  # Max characters for voice conversion
VOICE_CACHE_ENABLED=true  # Cache common voice responses

# Voice Triggers
VOICE_TRIGGER_KEYWORDS=voice,audio,speak,read aloud
VOICE_LENGTH_THRESHOLD=200  # Only use voice for responses longer than N chars

# Video Support Configuration
ENABLE_VIDEO_SUPPORT=true
VIDEO_MAX_SIZE_MB=16  # WhatsApp limit
VIDEO_PROCESSING_TIMEOUT=60  # seconds
VIDEO_FRAME_INTERVAL=5  # Extract frame every N seconds
VIDEO_MAX_DURATION=60  # Only process videos under N seconds
VIDEO_ANALYSIS_ENABLED=true  # Use AI to analyze video frames

# Cloud Storage for Videos (choose one)
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=whatsapp-videos
AWS_REGION=us-east-1

# Google Cloud Storage
GCS_ENABLED=false
GCS_PROJECT_ID=your-project-id
GCS_BUCKET=whatsapp-videos
GCS_KEY_FILE=/path/to/service-account.json

# Azure Blob Storage
AZURE_ENABLED=false
AZURE_STORAGE_ACCOUNT=your-account
AZURE_STORAGE_KEY=your-key
AZURE_CONTAINER=whatsapp-videos

# Video Processing
VIDEO_TEMP_DIR=/tmp/videos
VIDEO_AUTO_DELETE=true  # Delete after processing
VIDEO_RETENTION_DAYS=7  # Keep videos for N days

# Feature Cost Limits (monthly)
MONTHLY_VOICE_BUDGET_USD=50
MONTHLY_VIDEO_ANALYSIS_BUDGET_USD=100
ALERT_EMAIL=admin@company.com  # Alert when approaching limits

# ==============================================================================
# DOCKER COMPOSE CONFIGURATION
# ==============================================================================

# General Docker Settings
TIMEZONE=UTC
COMPOSE_PROJECT_NAME=wpsupport

# n8n Settings
N8N_ENCRYPTION_KEY=  # Generate with: openssl rand -hex 32
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_password_123
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console,file
N8N_PAYLOAD_SIZE_MAX=32  # MB - increased for video support
EXECUTIONS_MODE=queue  # Use queue mode for better performance
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# ==============================================================================
# STORAGE SERVICES (MinIO for Video/Media)
# ==============================================================================

# MinIO Configuration (S3-compatible storage)
MINIO_ENABLED=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123  # CHANGE IN PRODUCTION!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DOMAIN=localhost
MINIO_ENDPOINT=http://WPSupport_minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# MinIO Buckets (auto-created)
MINIO_BUCKET_VIDEOS=whatsapp-videos
MINIO_BUCKET_VOICE=whatsapp-voice
MINIO_BUCKET_MEDIA=whatsapp-media

# ==============================================================================
# VECTOR DATABASE (Qdrant for RAG)
# ==============================================================================

# Qdrant Configuration
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=  # Optional - leave empty for no auth

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# Prometheus Configuration
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=30

# Grafana Configuration
GRAFANA_ENABLED=false
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin  # CHANGE IN PRODUCTION!
GRAFANA_ROOT_URL=http://localhost:3000

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================

# Automated PostgreSQL Backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=@daily  # cron format or @daily, @weekly, @monthly
BACKUP_KEEP_DAYS=7  # Keep daily backups for 7 days
BACKUP_KEEP_WEEKS=4  # Keep weekly backups for 4 weeks
BACKUP_KEEP_MONTHS=6  # Keep monthly backups for 6 months

# ==============================================================================
# DEVELOPMENT TOOLS
# ==============================================================================

# pgAdmin Configuration
PGADMIN_ENABLED=false
PGADMIN_PORT=8080
PGADMIN_EMAIL=admin@wpsupport.local
PGADMIN_PASSWORD=admin  # CHANGE IN PRODUCTION!

# Redis Commander Configuration
REDIS_COMMANDER_ENABLED=false
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin  # CHANGE IN PRODUCTION!

# ==============================================================================
# SSL & REVERSE PROXY
# ==============================================================================

# Nginx Configuration (production only)
NGINX_ENABLED=false
NGINX_DOMAIN=your-domain.com
NGINX_EMAIL=admin@your-domain.com

# Certbot (Let's Encrypt SSL)
CERTBOT_EMAIL=admin@your-domain.com
CERTBOT_DOMAIN=your-domain.com

# ==============================================================================
# PRODUCTION DEPLOYMENT PROFILES
# ==============================================================================
#
# Available Docker Compose profiles:
# - production: Nginx, Certbot, Qdrant, MinIO, Prometheus, Grafana, Backup
# - development: pgAdmin, Redis Commander
# - storage: MinIO (for video/media storage)
# - rag: Qdrant (for vector search)
# - monitoring: Prometheus + Grafana
# - backup: Automated PostgreSQL backups
# - tools: Development tools (pgAdmin, Redis Commander)
#
# Examples:
# docker-compose up -d  # Core services only
# docker-compose --profile production up -d  # Full production
# docker-compose --profile development up -d  # With dev tools
#
# ==============================================================================
