      "id": "check-messages-exist",
      "name": "Check Messages Exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Process message templates with variables\nconst items = [];\n\nfor (const item of $input.all()) {\n  let messageContent = item.json.message_content;\n  \n  // If there's metadata with variables, replace them\n  if (item.json.metadata && typeof item.json.metadata === 'object') {\n    Object.keys(item.json.metadata).forEach(key => {\n      const placeholder = `{{${key}}}`;\n      messageContent = messageContent.replace(\n        new RegExp(placeholder, 'g'),\n        item.json.metadata[key]\n      );\n    });\n  }\n  \n  // Determine recipients\n  const recipients = [];\n  if (item.json.phone_number) {\n    recipients.push(item.json.phone_number);\n  }\n  if (item.json.phone_numbers && Array.isArray(item.json.phone_numbers)) {\n    recipients.push(...item.json.phone_numbers);\n  }\n  \n  // Create separate item for each recipient\n  recipients.forEach(recipient => {\n    items.push({\n      json: {\n        messageId: item.json.id,\n        phoneNumber: recipient,\n        message: messageContent,\n        mediaUrl: item.json.media_url,\n        mediaType: item.json.media_type\n      }\n    });\n  });\n}\n\nreturn items;"
      },
      "id": "process-templates",
      "name": "Process Templates",
      "type": "n8n-nodes-base.code",
